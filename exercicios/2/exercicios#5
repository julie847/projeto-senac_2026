def obter_elemento(lista, indice):
    try:
        return lista[indice]
    except IndexError:
        return "Posição inexistente."

if __name__ == '__main__':
    minha_lista = ['Banana', 'Melancia', 'Manga']
    
   
    print(obter_elemento(minha_lista, 1)) 
    
    print(obter_elemento(minha_lista, 5))